DATABASE_URL=mysql://root@localhost/dracker
APP_NAME="Dracker"
SPA_URL=http://localhost:42069
APP_PORT=3000

# Public origins, only needed when the apex page and the API are on different
# hosts (prod: APEX_URL=https://dracker.sh, API_URL=https://api.dracker.sh).
# Leave empty in dev; the landing page's signed-in check goes same-origin.
API_URL=
APEX_URL=

MAIL_HOST=localhost
MAIL_PORT=2525
MAIL_USER=root
MAIL_PASS=
MAIL_ADDR=root@localhost
MAIL_NAME="${APP_NAME}"
